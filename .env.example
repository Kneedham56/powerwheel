# Copy to .env.local (your data) or .env.demo (a demo database) and fill in.
# Supabase → Project Settings → API / Database. Never commit the filled-in copy.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server key. The legacy service_role JWT (Settings → API Keys → Legacy) is preferred:
# it avoids intermittent "JWT issued at future" errors. The sb_secret key also works.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection strings (Connect button in Supabase). DIRECT_URL is used by `npm run sql`.
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Only for a deployed copy (Vercel). Leave unset locally to skip the login.
# APP_PASSWORD=choose-a-long-password
# AUTH_SECRET=any-long-random-string

# Only for the public demo deployment: no login, read-only.
# DEMO_MODE=true
